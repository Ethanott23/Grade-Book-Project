#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;
// Function to get the computer's choice
char getComputerChoice() {
    int randChoice = rand() % 3; // Generate a number between 0 and 2
    if (randChoice == 0) return 'R';
    if (randChoice == 1) return 'P';
    return 'S';
}
// Function to determine the winner of a round
int determineWinner(char user, char computer) {
    if (user == computer) return 0; // Draw
    if ((user == 'R' && computer == 'S') ||
        (user == 'P' && computer == 'R') ||
        (user == 'S' && computer == 'P')) {
        return 1; // User wins
    }
    return -1; // Computer wins
}
int main() {
    srand(time(0)); // Seed for randomness
    
    int userScore = 0, computerScore = 0;
    char userChoice;
    string playAgain;
    
    cout << "Welcome to Rock, Paper, Scissors!" << endl;
    
    do {
        // Get user choice
        cout << "Enter R for Rock, P for Paper, or S for Scissors: ";
        cin >> userChoice;
        userChoice = toupper(userChoice);
        
        // Validate input
        while (userChoice != 'R' && userChoice != 'P' && userChoice != 'S') {
            cout << "Invalid choice. Please enter R, P, or S: ";
            cin >> userChoice;
            userChoice = toupper(userChoice);
        }
        
        // Get computer choice
        char computerChoice = getComputerChoice();
        cout << "Computer chose: " << computerChoice << endl;
        
        // Determine winner
        int result = determineWinner(userChoice, computerChoice);
        if (result == 1) {
            cout << "You win this round!" << endl;
            userScore++;
        } else if (result == -1) {
            cout << "Computer wins this round!" << endl;
            computerScore++;
        } else {
            cout << "It's a draw!" << endl;
        }
        
        // Display scores
        cout << "Score - You: " << userScore << " Computer: " << computerScore << endl;
        
        // Ask to play again
        cout << "Do you want to play another round? (yes/no): ";
        cin >> playAgain;
    } while (playAgain == "yes" || playAgain == "YES" || playAgain == "y" || playAgain == "Y");
    
    // Display final results
    cout << "Final Score - You: " << userScore << " Computer: " << computerScore << endl;
    if (userScore > computerScore) {
        cout << "Congratulations! You won the tournament!" << endl;
    } else if (userScore < computerScore) {
        cout << "Computer wins the tournament! Better luck next time." << endl;
    } else {
        cout << "The tournament ends in a draw!" << endl;
    }
    
    return 0;
}
