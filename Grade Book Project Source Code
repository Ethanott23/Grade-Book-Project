#include <iostream>
#include <fstream>
#include <string>
#include <iomanip> // For setw and setprecision
using namespace std;
const int NUM_TESTS = 5; // Global constant for number of test scores
const int MAX_STUDENTS = 100; // Maximum number of students
// Function to read data from file
int readData(ifstream& file, string names[], double testScores[][NUM_TESTS]) {
    int numStudents = 0;
    while (file >> names[numStudents]) {
        for (int i = 0; i < NUM_TESTS; i++) {
            file >> testScores[numStudents][i];
        }
        numStudents++;
        if (numStudents >= MAX_STUDENTS) {
            cout << "Error: Too many students in file." << endl;
            return numStudents;
        }
    }
    return numStudents;
}
// Function to calculate averages
void calculateAverages(double testScores[][NUM_TESTS], double averages[], int numStudents) {
    for (int i = 0; i < numStudents; i++) {
        double sum = 0;
        for (int j = 0; j < NUM_TESTS; j++) {
            sum += testScores[i][j];
        }
        averages[i] = sum / NUM_TESTS;
    }
}
// Function to calculate letter grade
char calculateGrade(double average) {
    if (average >= 90) {
        return 'A';
    } else if (average >= 80) {
        return 'B';
    } else if (average >= 70) {
        return 'C';
    } else if (average >= 60) {
        return 'D';
    } else {
        return 'F';
    }
}
// Function to produce formatted report
void printReport(string names[], double averages[], int numStudents) {
    cout << setw(10) << "Student" << setw(15) << "Average Score" << setw(15) << "Letter Grade" << endl;
    cout << setw(50) << setfill('-') << "" << endl;
    cout << setfill(' ');
    for (int i = 0; i < numStudents; i++) {
        cout << setw(10) << names[i] << setw(15) << fixed << setprecision(2) << averages[i] << setw(15) << calculateGrade(averages[i]) << endl;
    }
}
int main() {
    ifstream file("StudentGrades.txt");
    if (!file) {
        cout << "Error: Unable to open file." << endl;
        return 1;
    }
    string names[MAX_STUDENTS];
    double testScores[MAX_STUDENTS][NUM_TESTS];
    double averages[MAX_STUDENTS];
    int numStudents = readData(file, names, testScores);
    calculateAverages(testScores, averages, numStudents);
    printReport(names, averages, numStudents);
    file.close();
    return 0;
}
